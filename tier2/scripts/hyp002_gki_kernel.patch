+ */
+static ssize_t ep_dbg_reset_write(struct file *file, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	atomic_set(&ep_dbg_fep_cleared, 0);
+	atomic_set(&ep_dbg_uaf_detected, 0);
